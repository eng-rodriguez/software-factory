# .factory.yml — read by the factory hooks and orchestrators. Delete areas that don't exist.
# Monorepo example:
layout: monorepo            # monorepo | polyrepo
default_branch: main
areas:
  backend: { path: backend, stack: django }
  web:     { path: web, stack: react }
  infra:   { path: infra, stack: terraform }
  deploy:  { path: deploy, stack: helm }

# Polyrepo example (one layer per repo):
# layout: polyrepo
# default_branch: main
# home: true                # only in the repo that holds stories, briefs and ADRs
# areas:
#   backend: { path: ., stack: django }
# repos:                    # only in the home repo
#   web:   { path: ../app-web }
#   infra: { path: ../app-infra }

# Prefer the project's existing complete check command; supported in both modes.
# commands:
#   check: make check
# Zero collected tests fail by default. Enable only for intentionally test-free projects
# and record manual evidence; this does not turn skipped tests into passed tests.
# checks:
#   allow_no_tests: true
