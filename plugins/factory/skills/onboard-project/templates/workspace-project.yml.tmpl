# Save at <workspace>/.factory/projects/<project-id>.yml.
# Detect actual commands, branch and stack; remove areas that do not exist.
layout: polyrepo
default_branch: main
areas:
  backend: { path: ., stack: django }
# Optional: the repository's existing complete local check command.
# commands:
#   check: make check
# Store project facts, contracts, test tools and conventions in <project-id>.md.

# Stacks are detected facts, not a closed list. Example for an existing Go/Angular repo:
# areas:
#   backend: { path: services/api, stack: go }
#   web: { path: client, stack: angular }
# commands:
#   check: make check  # Only if this complete target actually exists; runs from Git root.
# Existing project checks override built-in stack commands. Other stacks require this
# command; the factory does not substitute Django or Vitest checks.
